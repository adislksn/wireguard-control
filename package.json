    "@tanstack/charts": "^1.1.0",
    "@tanstack/table-core": "^8.21.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "nuxt": "^4.6.4",
    "qrcode": "^1.5.4",
    "scule": "^1.3.0",
