# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Local SQLite (libsql) via Drizzle
DATABASE_URL=file:./.data/wgcontrol.sqlite

# Bootstrap admin (created only if no users exist)
WGCONTROL_ADMIN_USER=admin
WGCONTROL_ADMIN_PASSWORD=changeme

# Bind dashboard to localhost
NUXT_HOST=127.0.0.1
NUXT_PORT=3000
