#!/usr/bin/env python3
"""Read-only WireGuard status. Never prints private keys."""
import json
import os
import subprocess
import sys


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def main():
    payload = json.loads(sys.stdin.read() or "{}")
    iface = payload.get("interface") or "wg0"
    conf = f"/etc/wireguard/{iface}.conf"
    exists = os.path.exists(conf)
    show = run(["wg", "show", iface, "dump"])
    iface_link = run(["ip", "-br", "link", "show", "dev", iface])
    active = show.returncode == 0
    peers = []
    interface = None
    if active and show.stdout.strip():
        lines = show.stdout.strip().splitlines()
        parts = lines[0].split("\t")
        interface = {
            "publicKey": parts[1] if len(parts) > 1 else "",
            "listenPort": parts[2] if len(parts) > 2 else "",
            "fwmark": parts[3] if len(parts) > 3 else "",
        }
        for line in lines[1:]:
            p = line.split("\t")
            peers.append({
                "publicKey": p[0],
                "endpoint": p[2] if len(p) > 2 else "",
                "allowedIps": p[3] if len(p) > 3 else "",
                "latestHandshake": int(p[4] or 0),
                "rxBytes": int(p[5] or 0),
                "txBytes": int(p[6] or 0),
            })
    print(json.dumps({
        "ok": True,
        "data": {
            "interface": iface,
            "confExists": exists,
            "active": active,
            "link": iface_link.stdout.strip(),
            "interfaceInfo": interface,
            "peers": peers,
            "peerCount": len(peers),
        }
    }, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        sys.exit(1)
