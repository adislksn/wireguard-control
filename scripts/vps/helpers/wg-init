#!/usr/bin/env python3
"""Initialize WireGuard in Nyr-compatible format. Requires root."""
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone


def sh(cmd, check=True, input_text=None):
    return subprocess.run(
        cmd,
        input=input_text,
        capture_output=True,
        text=True,
        check=check,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive", "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
    )


def detect_public_iface():
    out = sh(["ip", "-4", "route", "show", "default"]).stdout
    m = re.search(r"dev\s+(\S+)", out)
    if not m:
        raise RuntimeError("Could not detect public network interface")
    return m.group(1)


def gen_key():
    priv = sh(["wg", "genkey"]).stdout.strip()
    pub = sh(["wg", "pubkey"], input_text=priv + "\n").stdout.strip()
    return priv, pub


def backup(paths):
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    dest = f"/root/wgcontrol-backups/{ts}"
    os.makedirs(dest, mode=0o700, exist_ok=True)
    for path in paths:
        if os.path.exists(path):
            if os.path.isdir(path):
                shutil.copytree(path, os.path.join(dest, os.path.basename(path)), dirs_exist_ok=True)
            else:
                shutil.copy2(path, dest)
    return dest


def apt_install(packages):
    import time
    last_err = ""
    for attempt in range(1, 13):
        # wait for unattended-upgrades / other apt locks
        locks = sh(["bash", "-lc", "fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock 2>/dev/null || true"], check=False)
        if locks.stdout.strip():
            time.sleep(5)
            continue
        update = sh(["apt-get", "update"], check=False)
        if update.returncode != 0:
            last_err = update.stderr.strip() or update.stdout.strip()
            time.sleep(5)
            continue
        inst = sh(["apt-get", "install", "-y", *packages], check=False)
        if inst.returncode == 0:
            return
        last_err = inst.stderr.strip() or inst.stdout.strip()
        if "lock" in last_err.lower():
            time.sleep(5)
            continue
        raise RuntimeError(f"apt-get install failed: {last_err}")
    raise RuntimeError(f"apt-get install failed after retries: {last_err}")


def main():
    if os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "root required"}))
        sys.exit(1)

    payload = json.loads(sys.stdin.read() or "{}")
    iface = payload.get("interfaceName") or "wg0"
    listen_port = int(payload.get("listenPort") or 51820)
    subnet = payload.get("wgSubnet") or "10.7.0.0/24"
    server_ip = payload.get("serverVpnIp") or "10.7.0.1"
    upstream_dns = payload.get("upstreamDns") or "1.1.1.1"
    force = bool(payload.get("force"))
    conf = f"/etc/wireguard/{iface}.conf"

    live = []
    if shutil.which("wg"):
        show = subprocess.run(
            ["wg", "show", "interfaces"],
            capture_output=True,
            text=True,
            env={**os.environ, "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
        )
        live = (show.stdout or "").split() if show.returncode == 0 else []
    if (iface in live or os.path.exists(conf)) and not force:
        print(json.dumps({"ok": False, "error": f"WireGuard {iface} already exists; pass force=true to overwrite after backup"}))
        sys.exit(2)

    bak = backup(["/etc/wireguard"] if os.path.exists("/etc/wireguard") else [])

    apt_install(["wireguard", "wireguard-tools", "qrencode"])

    if not shutil.which("wg"):
        raise RuntimeError("wg binary missing after package install")

    public_iface = detect_public_iface()
    priv, pub = gen_key()
    os.makedirs("/etc/wireguard", mode=0o700, exist_ok=True)

    prefix = subnet.split("/")[-1] if "/" in subnet else "24"
    conf_body = f"""# Generated by wgcontrol (Nyr-compatible markers)
[Interface]
Address = {server_ip}/{prefix}
ListenPort = {listen_port}
PrivateKey = {priv}
PostUp = iptables -A FORWARD -i {iface} -j ACCEPT; iptables -A FORWARD -o {iface} -j ACCEPT; iptables -t nat -A POSTROUTING -o {public_iface} -j MASQUERADE
PostDown = iptables -D FORWARD -i {iface} -j ACCEPT; iptables -D FORWARD -o {iface} -j ACCEPT; iptables -t nat -D POSTROUTING -o {public_iface} -j MASQUERADE
"""
    with open(conf, "w") as f:
        f.write(conf_body)
    os.chmod(conf, 0o600)

    with open("/etc/sysctl.d/99-wgcontrol-forward.conf", "w") as f:
        f.write("net.ipv4.ip_forward=1\n")
    sh(["sysctl", "--system"], check=False)

    if shutil.which("ufw"):
        sh(["ufw", "allow", f"{listen_port}/udp"], check=False)
        sh(["ufw", "route", "allow", "in", "on", iface, "out", "on", public_iface], check=False)
        ufw_def = "/etc/default/ufw"
        if os.path.exists(ufw_def):
            text = open(ufw_def).read()
            text = re.sub(r"^DEFAULT_FORWARD_POLICY=.*$", 'DEFAULT_FORWARD_POLICY="ACCEPT"', text, flags=re.M)
            open(ufw_def, "w").write(text)
        sh(["ufw", "--force", "reload"], check=False)

    sh(["systemctl", "enable", f"wg-quick@{iface}"], check=False)
    up = sh(["systemctl", "restart", f"wg-quick@{iface}"], check=False)
    if up.returncode != 0:
        print(json.dumps({
            "ok": False,
            "error": up.stderr.strip() or up.stdout.strip() or "failed to start wg-quick",
            "backup": bak
        }))
        sys.exit(1)

    meta = {
        "interface": iface,
        "listenPort": listen_port,
        "serverVpnIp": server_ip,
        "subnet": subnet,
        "publicKey": pub,
        "publicIface": public_iface,
        "upstreamDns": upstream_dns,
        "backup": bak,
    }
    os.makedirs("/var/lib/wgcontrol", mode=0o755, exist_ok=True)
    with open("/var/lib/wgcontrol/server.json", "w") as f:
        json.dump(meta, f, indent=2)
        f.write("\n")

    print(json.dumps({"ok": True, "data": meta}, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        sys.exit(1)
