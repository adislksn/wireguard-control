#!/usr/bin/env python3
"""Pause a peer without revoke: remove from live wg, stash conf block, keep client conf."""
import json
import os
import re
import subprocess
import sys

BEGIN = "# BEGIN_PEER "
END = "# END_PEER "
PAUSED_DIR = "/var/lib/wgcontrol/paused"


def client_safe(public_key: str) -> str:
    return re.sub(r"[^A-Za-z0-9_-]", "_", public_key.rstrip("="))


def main():
    if os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "root required"}))
        sys.exit(1)

    payload = json.loads(sys.stdin.read() or "{}")
    name = payload.get("name") or ""
    public_key = payload.get("publicKey") or ""
    iface = payload.get("interface") or "wg0"
    if not name or not public_key:
        print(json.dumps({"ok": False, "error": "name and publicKey required"}))
        sys.exit(2)
    if not re.fullmatch(r"[A-Za-z0-9+/]{42,44}=", public_key):
        print(json.dumps({"ok": False, "error": "invalid public key"}))
        sys.exit(2)

    conf_path = f"/etc/wireguard/{iface}.conf"
    if not os.path.exists(conf_path):
        print(json.dumps({"ok": False, "error": "missing wg conf"}))
        sys.exit(1)

    conf = open(conf_path).read()
    start = f"{BEGIN}{name}"
    end = f"{END}{name}"
    stash_path = os.path.join(PAUSED_DIR, f"{client_safe(public_key)}.block")

    # Already paused (stash exists)
    if os.path.exists(stash_path) and start not in conf:
        subprocess.run(["wg", "set", iface, "peer", public_key, "remove"], check=False)
        print(json.dumps({"ok": True, "data": {"name": name, "publicKey": public_key, "alreadyPaused": True}}, separators=(",", ":")))
        return

    if start not in conf or end not in conf:
        print(json.dumps({"ok": False, "error": "peer block not found"}))
        sys.exit(2)

    block_match = re.search(re.escape(start) + r"([\s\S]*?)" + re.escape(end), conf)
    if not block_match or public_key not in block_match.group(0):
        print(json.dumps({"ok": False, "error": "peer name/public key mismatch"}))
        sys.exit(2)

    full_block = block_match.group(0)
    subprocess.run(["wg", "set", iface, "peer", public_key, "remove"], check=False)

    os.makedirs(PAUSED_DIR, mode=0o700, exist_ok=True)
    open(stash_path, "w").write(full_block.rstrip() + "\n")
    os.chmod(stash_path, 0o600)

    # Remove block from conf
    lines = conf.splitlines()
    out = []
    skipping = False
    for line in lines:
        if line == start:
            skipping = True
            continue
        if skipping:
            if line == end:
                skipping = False
            continue
        out.append(line)

    open(conf_path + ".bak", "w").write(conf)
    open(conf_path, "w").write("\n".join(out).rstrip() + "\n")
    os.chmod(conf_path, 0o600)

    print(json.dumps({"ok": True, "data": {"name": name, "publicKey": public_key, "paused": True}}, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        sys.exit(1)
